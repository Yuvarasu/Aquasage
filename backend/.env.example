# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="AI-Powered Rural Water Infrastructure Monitoring Platform"
API_V1_STR=/api/v1
SECRET_KEY=aquasage-super-secret-key-change-in-production-2026-secure-jwt-token-hash-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aquasage_db
# Set DATABASE_URL directly if using full URI (e.g., sqlite+aiosqlite:///./test.db or postgresql+asyncpg://...)
# If DATABASE_URL is empty, Pydantic settings will assemble it from POSTGRES_* fields.
DATABASE_URL=sqlite+aiosqlite:///./aquasage.db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000"]

# Logging
LOG_LEVEL=INFO
